Options +FollowSymLinks +SymLinksIfOwnerMatch
RewriteEngine On

# ============================================================
# LITESPEED / APACHE REWRITE ENGINE
# ============================================================

RewriteEngine On

# REQUIRED for LiteSpeed mod_rewrite to work
Options +FollowSymLinks

<IfModule mod_dir.c>
    DirectoryIndex index.html index.php
</IfModule>

RewriteBase /
Options -Indexes

# ============================================================
# PRIVATE FILES — internal files are never served to visitors (403).
# Pages, images, CSS/JS, sitemaps, feeds and robots.txt are not affected.
# ============================================================
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^(includes|mailers|cj_smart_cache|vendor)/ - [F,L]
RewriteRule ^(composer\.(json|lock)|readme\.md|ttxfolder|db_cron\.php|author/test\.php)$ - [F,L]
RewriteCond %{REQUEST_URI} !^/uploads/
RewriteRule \.(bak|old|orig|save|swp|sql|gz|tgz|tar|zip|rar|7z|log|ini|env|sh|ya?ml|dist)$ - [F,L]

# ============================================================
# DEAD ROUTES — 410 Gone
# ============================================================

# ============================================================
# WWW → NON-WWW REDIRECT
# ============================================================
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
# Online store — clean addresses (old /store/item?s=… and /store/learn?s=… redirect in PHP)
RewriteRule ^courses/?$ store/list.php?m=courses [L,QSA]
RewriteRule ^upcoming-courses/?$ store/list.php?m=upcoming [L,QSA]
RewriteRule ^all-categories/?$ store/list.php?m=cats [L,QSA]
RewriteRule ^courses/([a-zA-Z0-9-]+)/?$ store/item.php?s=$1 [L,QSA]
RewriteRule ^notes/?$ store/list.php?m=notes [L,QSA]
RewriteRule ^notes/([a-zA-Z0-9-]+)/?$ store/item.php?s=$1 [L,QSA]
RewriteRule ^category/([a-zA-Z0-9-]+)/?$ store/index.php?c=$1 [L,QSA]
RewriteRule ^learn/([a-zA-Z0-9-]+)/?$ store/learn.php?s=$1 [L,QSA]
RewriteRule ^free-courses/?$ store/free.php [L,QSA]
RewriteRule ^free-courses/([0-9]+)(-[a-zA-Z0-9-]*)?/?$ store/free.php?id=$1 [L,QSA]
RewriteRule ^category(/.*)?$ - [G,L]

# ============================================================
# PHP CONFIGURATION
# ============================================================
<IfModule php8_module>
    php_value date.timezone "Asia/Kolkata"
</IfModule>

# ============================================================
# BROWSER CACHING
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ============================================================
# ERROR PAGES
# ============================================================
ErrorDocument 404 /templates/page_not_found.php

# ============================================================
# URL ROUTING — CLEAN URLS
# ============================================================

# Static pages FIRST (before the catch-all post rule)
RewriteRule ^about-us/?$ /pages/about-us.php [L,QSA,NC]
RewriteRule ^contact-us/?$ /pages/contact-us.php [L,QSA,NC]
RewriteRule ^terms-of-service/?$ /pages/terms-of-service.php [L,QSA,NC]
RewriteRule ^cookie-policy/?$ /pages/cookie-policy.php [L,QSA,NC]
RewriteRule ^privacy-policy/?$ /pages/privacy-policy.php [L,QSA,NC]
RewriteRule ^disclaimer/?$ /pages/disclaimer.php [L,QSA,NC]
RewriteRule ^affiliate-disclaimer/?$ /pages/affiliate-disclaimer.php [L,QSA,NC]
RewriteRule ^editorial-policy/?$ /pages/editorial-policy.php [L,QSA,NC]
RewriteRule ^commercial-policy/?$ /pages/commercial-policy.php [L,QSA,NC]

# Search
RewriteRule ^search/?$ search.php [L,QSA]

# Categories listing
RewriteRule ^categories/?$ categories.php [L,QSA]

# Taxonomy & metadata pages
RewriteRule ^tag/([a-z0-9-]+)-([0-9]+)/?$ tag.php?id=$2 [L,QSA]
RewriteRule ^categories/([a-zA-Z0-9-]+)/?$ category.php?slug=$1 [L,QSA]
RewriteRule ^author/([a-zA-Z0-9_-]+)/?$ author.php?slug=$1 [L,QSA]

# State jobs
RewriteRule ^state-jobs/?$ states.php [L]
RewriteRule ^state-jobs/([a-zA-Z0-9-]+)/?$ state-jobs.php?slug=$1 [L]

# Web stories
RewriteRule ^web-stories/?$ /stories/ [R=301,L]
RewriteRule ^web-stories/([a-z0-9-]+-[0-9]+)/?$ /story/$1 [R=301,L]
RewriteRule ^story/([a-z0-9-]+)-([0-9]+)/?$ stories/view.php?id=$2 [L,QSA]

# Documents
RewriteRule ^documents/(\d+)$ doc.php?id=$1 [L,QSA]

# XML feeds
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteRule ^news-sitemap\.xml$ news-sitemap.php [L]
RewriteRule ^rss\.xml$ rss.php [L]

# Blog post — catch-all (slug-id pattern) — MUST be last
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-zA-Z0-9-]+)-([0-9]+)/?$ post.php?id=$2 [L,QSA]

# PHP extension-less URLs
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

# Pages made in Admin → Pages (/page-address); anything else unknown gets the site's own 404 page
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]+)/?$ page.php?slug=$1 [L,QSA]

# ============================================================
# PDF HOTLINK PROTECTION
# ============================================================
RewriteCond %{HTTP_HOST}@@%{HTTP_REFERER} !^(?:www\.)?([^@]+)@@https?://(?:www\.)?\1(?:[:/].*)?$ [NC]
RewriteCond %{HTTP_REFERER} !^$
RewriteRule \.(pdf)$ - [F,L]
